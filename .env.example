############################################################
# AbiesZipZap - AbiesWeb -> Abies+
# Repositorio original: https://github.com/clmmakers/AbiesZipZap
# Plantilla de configuracion. Copia este archivo a .env y
# rellena solo las credenciales obligatorias de NIVEL 1.
# El resto tiene valores por defecto razonables.
############################################################

############################################################
# NIVEL 1: DATOS QUE DEBE RELLENAR EL USUARIO (OBLIGATORIOS)
############################################################

# --- AbiesWeb (exportacion de backups) ---
# URL base de la instancia AbiesWeb del programa exterior.
ABIES_BASE_URL=http://www.programasexterior.abiesweb.org
ABIES_USERNAME=usuario_admin_abiesweb
ABIES_PASSWORD=tu_password_abiesweb

# --- Abies+ (alta de bibliotecas) ---
# URL base de la instancia Abies+ destino. Si usas una instancia local que genera
# enlaces/formularios con http://abiesplus-local:8080, usa exactamente ese origen;
# mezclarlo con host.docker.internal puede romper la cookie de sesion.
ABIESPLUS_BASE_URL=https://abiesplus-sc.pre.intef.es
ABIESPLUS_USERNAME=usuario_admin_abiesplus
ABIESPLUS_PASSWORD=tu_password_abiesplus
# Equivalencias de provincia para validar DB/XML y seleccionar provincia en el formulario.
# Formato: codigo=alias|alias2,codigo=alias (admite , o ; como separador de entradas).
# Ajustalo segun las provincias/codigos que vayas a incluir en tu lote.
# Ejemplo (instancias con centros de exterior):
ABIESPLUS_PROVINCE_EQUIVALENCES=60=exteriores|extranjero,52=melilla,51=ceuta

# Si tu instancia AbiesWeb requiere seleccionar un centro antes del login,
# indica aqui el texto exacto. Dejalo vacio si no aplica.
# OBLIGATORIO para programasexterior.abiesweb.org: la pantalla de prelogin
# pide "Escribe tu centro" (#autocomplete_UO) antes de mostrar el formulario
# de usuario/clave. Sin este valor el login aborta con Timeout esperando a
# #signin_username. Usa un centro que aparezca en el autocompletado
# (p.ej. "C.C. La Inmaculada").
PRELOGIN_CENTER_TEXT=

####################################################################
# NIVEL 2: PARAMETROS TECNICOS (NO TOCAR salvo ajuste muy consciente)
####################################################################

# --- Rutas AbiesWeb ---
ABIES_LOGIN_PATH=/visitas/preHomePublica
ABIES_PROTECTED_PATH=/datosCentro/edit/action
ABIES_TOOLS_PATH=/importacion?eMenuActivo=1&eSubmenuActivo=0
ABIES_EXPORT_PATH=/exportacion?eMenuActivo=1&eSubmenuActivo=1

# --- Flujo por cambio de perfil (AbiesWeb) ---
USE_PROFILE_SWITCH=true
SELECTOR_CHANGE_PROFILE_LINK=text=cambiar perfil
SELECTOR_PROFILE_ROWS=tr
PROFILE_ADMIN_LABEL=Administrador AbiesWeb

# --- Navegador ---
HEADLESS=true
BROWSER=chromium

# --- Paralelismo / reintentos AbiesWeb ---
MAX_TABS=2
MAX_CENTERS_PER_BATCH=20
POLL_INTERVAL_SECONDS=300
MAX_RETRIES_PER_CENTER=2

# --- Selectores login AbiesWeb ---
SELECTOR_PRELOGIN_CENTER_INPUT=#autocomplete_UO
SELECTOR_PRELOGIN_SUBMIT=input[name='ir']
SELECTOR_USER=#signin_username
SELECTOR_PASSWORD=#signin_password
SELECTOR_LOGIN_BUTTON=#entrar
SELECTOR_POST_LOGIN_READY=text=salir

# --- Selectores exportacion AbiesWeb ---
SELECTOR_CENTER_INPUT=input[name='centro']
SELECTOR_ROLE_SELECT=select[name='rol']
SELECTOR_SWITCH_BUTTON=button[data-action='switch-center-role']
SELECTOR_EXPORT_TRIGGER=#Exportacion
SELECTOR_STATUS_TEXT=AUTO
SELECTOR_DOWNLOAD_LINK=a:has-text('Descarga')

# --- Selectores de menu AbiesWeb (overridables; defaults para programasexterior) ---
SELECTOR_GESTION_MENU=#menu000_txt
SELECTOR_GESTORES_SUBMENU=#submenu001_txt
SELECTOR_GESTORES_INPUT=input.custom-combobox-input.ui-autocomplete-input
SELECTOR_TOOLS_MENU=#menu001_txt
SELECTOR_EXPORT_SUBMENU=#submenu001_txt

# --- Timeout de descarga del ZIP (ms); por defecto 120s ---
DOWNLOAD_TIMEOUT_MS=120000

# --- Estados esperados AbiesWeb ---
STATUS_PENDING=pendiente
STATUS_IN_PROGRESS=porcentaje completado
STATUS_FINISHED=ya puedes descargar
STATUS_ERROR=error

# --- Archivos de salida/estado AbiesWeb (rutas relativas a v2/) ---
STATE_FILE=./state/v2_state.json
LOG_FILE=./logs/abies_v2.log
OUTPUT_DIR=./downloads
MAPPING_CSV=./data/mapeo_descargas.csv

# --- Reutilizacion sesion Playwright (AbiesWeb) ---
REUSE_AUTH_STATE=true
AUTH_STATE_FILE=./state/auth_state.json

# --- Rutas y archivos Abies+ ---
ABIESPLUS_LOGIN_PATH=/
ABIESPLUS_BIBLIOTECAS_PATH=/bibliotecas/index
ABIESPLUS_LOG_FILE=./logs/abiesplus_import.log
ABIESPLUS_STATE_FILE=./state/abiesplus_state.json

# --- Selectores Abies+ ---
SELECTOR_PLUS_USER=#usr
SELECTOR_PLUS_PASSWORD=#pwd
SELECTOR_PLUS_LOGIN_SUBMIT=#login
SELECTOR_PLUS_LOGIN_ANCHOR=a.btn-login
SELECTOR_PLUS_NEW_BUTTON=span.badd:has-text('Nueva')

# --- Opciones de lote Abies+ ---
ABIESPLUS_ASK_BATCH_OPTIONS=true
ABIESPLUS_DEFAULT_USAR_REGISTRO=false
ABIESPLUS_DEFAULT_SYNCUSERS=false
ABIESPLUS_DEFAULT_IMPORTUSERS=false
